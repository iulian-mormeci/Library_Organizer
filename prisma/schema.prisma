generator client {
  provider = "prisma-client-js"
  // "native" covers local dev (macOS/whatever the host is). The Docker
  // image's builder and runner stages both use node:20-bookworm-slim
  // (Debian 12, OpenSSL 3.0), but that auto-detected "native" target is
  // only as reliable as the builder stage's ability to probe libssl at
  // `prisma generate` time — listing debian-openssl-3.0.x explicitly means
  // the right query engine is always bundled regardless of that detection.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Track {
  id        String   @id @default(cuid())
  path      String   @unique
  filename  String

  artist String?
  title  String?
  album  String?
  year   Int?

  durationSeconds Float?
  bitrate         Int?
  format          String?
  fileSize        BigInt?

  fileHash String? // SHA256, exact byte-for-byte duplicate detection

  fingerprint         String? @db.Text // Chromaprint raw fingerprint, JSON-encoded int array
  fingerprintDuration Float? // duration (s) actually used to compute the fingerprint

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileHash])
  @@index([artist, title])
  @@index([durationSeconds])
}

// A scan is tracked as a job so the dashboard can show progress / last run
// without blocking the HTTP request that triggered it.
model ScanJob {
  id          String   @id @default(cuid())
  libraryPath String
  status      String // "running" | "completed" | "failed"

  filesFound   Int @default(0)
  filesScanned Int @default(0)
  filesAdded   Int @default(0)
  filesUpdated Int @default(0)
  filesFailed  Int @default(0)

  // Live progress, polled by the dashboard while status = "running".
  // totalFiles is nullable because it's only known once the initial
  // directory walk completes.
  totalFiles     Int?
  processedFiles Int     @default(0)
  currentFile    String?

  error String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// Duplicate detection is too expensive to run synchronously inside a
// request handler (pairwise Levenshtein/fingerprint comparisons over the
// whole library), so it runs as a background job — same pattern as
// ScanJob — and its output is persisted here instead of being
// recomputed on every GET /api/duplicates.
model DuplicateComputeJob {
  id     String @id @default(cuid())
  status String // "running" | "completed" | "failed"

  groupCount Int     @default(0)
  error      String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// One row per detected duplicate group from the most recent completed
// DuplicateComputeJob. trackIds references Track.id but isn't a formal
// Prisma relation (kept simple, same as ScanJob's loose coupling to
// Track) — reads batch-fetch the referenced tracks in one query.
model DuplicateGroupResult {
  id         String   @id @default(cuid())
  jobId      String
  level      String // "exact-hash" | "fuzzy-metadata" | "fingerprint"
  confidence Float
  trackIds   String[]
  computedAt DateTime @default(now())

  @@index([jobId])
}
