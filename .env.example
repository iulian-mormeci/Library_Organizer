# --- Postgres ---
POSTGRES_USER=music_dedup
POSTGRES_PASSWORD=change-me
POSTGRES_DB=music_dedup

# Used by the app container to connect to Postgres. When running via
# docker-compose this is built for you from the vars above, but the app
# also reads it directly if you run `next dev` / cli-scan on the host.
DATABASE_URL=postgresql://music_dedup:change-me@localhost:5432/music_dedup

# --- Music library ---
# Host-side path bind-mounted into the app container. Point this at your
# TrueNAS NFS mount, e.g. /mnt/pve/truenas-music (mounted read-only on the
# Proxmox host / VM beforehand — docker-compose.yml just bind-mounts it in).
LIBRARY_PATH_ON_HOST=./library-example

# Path as seen *inside* the container (left side of the bind mount above).
LIBRARY_PATH_IN_CONTAINER=/music

# Bind mount mode Docker enforces for the library inside the container:
# "ro" (default, safe) or "rw". This is independent of the underlying NFS
# export's own permissions — Docker applies this at the mount namespace
# level regardless. Set to "rw" (and recreate the container with
# `docker compose up -d`) if you want the "Delete" button in the UI to be
# able to actually delete files instead of failing with a read-only error.
LIBRARY_MOUNT_MODE=ro

# Same path, used by the app when it triggers a scan without an explicit
# path in the request body, and by `npm run scan` when run inside the
# container.
LIBRARY_PATH=/music

# --- App ---
APP_PORT=3000

# Path to the fpcalc binary (Chromaprint). Only needed if it's not on PATH.
# The Docker image installs it via libchromaprint-tools at /usr/bin/fpcalc.
FPCALC_PATH=fpcalc
